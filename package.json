{
  "name": "air-signal-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "wrangler types && astro check",
    "prebuild": "wrangler types",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "db:init": "wrangler d1 execute air-signal --local --file=db/schema.sql",
    "db:init:remote": "wrangler d1 execute air-signal --remote --file=db/schema.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && pnpm db:init",
    "seed": "tsx cli/main.ts seed-cities",
    "ingest": "tsx cli/main.ts ingest",
    "comfort": "tsx cli/main.ts comfort",
    "integration": "tsx cli/main.ts integration",
    "deploy": "pnpm build && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/react": "^5.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.6",
    "maplibre-gl": "^6.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.117.0"
  }
}

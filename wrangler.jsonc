{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "air-signal-web",
  // The unified entrypoint the adapter ships in v13 — the same file serves `astro dev` and the
  // deployed worker. Pointing this at a path under dist/ instead fails before the build has made
  // it, because the Cloudflare Vite plugin resolves `main` at config time.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-06",

  // `nodejs_compat` is what lets the Astro server bundle run at all.
  // `global_fetch_strictly_public` makes a `fetch()` to our own origin leave the worker and come
  // back through the edge, instead of being short-circuited — without it, a page fetching its own
  // /api/ route silently bypasses the cache it was written to use.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "air-signal",
      // Filled by `wrangler d1 create air-signal`. Committed so every machine and CI talk to the
      // same database — it is an id, not a secret.
      "database_id": "2bbc6622-0292-46e6-8b80-be39ec1a2ae0"
    }
  ],

  "observability": { "enabled": true },

  // The domain is the product name; workers.dev stays off so there is exactly one indexable host
  // and nothing competes with it in search.
  "workers_dev": false,
  "routes": [
    { "pattern": "airsignal.app", "custom_domain": true },
    // Both answer, neither ranks: src/middleware.ts 301s them to the canonical host. `www` is the
    // habit everyone has, and `air.miralinka.com` is where the Next version lived — pointing it
    // here rather than leaving it on Vercel is what transfers its history instead of competing
    // with it as a duplicate. It lands on Gazipaşa, the town its parent site is about.
    { "pattern": "www.airsignal.app", "custom_domain": true }
    // `air.miralinka.com` belongs here too — src/middleware.ts already 301s it to Gazipaşa, the
    // town its parent site is about — but Cloudflare refuses to attach a custom domain over an
    // existing DNS record:
    //
    //   Hostname 'air.miralinka.com' already has externally managed DNS records (A, CNAME, etc).
    //   Delete them first or try a different hostname. [code: 100117]
    //
    // and that hostname is still a CNAME to `447977cad7031e50.vercel-dns-017.com` in the
    // miralinka.com zone. Delete that record, then add the line back. Left commented rather than
    // present-and-failing, because a route that cannot attach makes every deploy exit non-zero and
    // the real failure stops being visible.
  ]
}

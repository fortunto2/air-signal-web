---
import { SITE, DEFAULT_LANG, LANGS, abs } from "../lib/site";
import "../styles/tokens.css";
import "../styles/components.css";

interface Props {
  title: string;
  description: string;
  /** Path of this page, without a trailing slash. Canonical derives from it. */
  path: string;
  /** JSON-LD nodes for the page. City and station pages always set them. */
  schema?: unknown[];
  /**
   * Where the canonical should point when it is not this page. A station below the indexing bar
   * canonicals to its city: the page is worth having, it is not worth competing with the page that
   * answers the same question better.
   */
  canonicalTo?: string;
  noindex?: boolean;
  /** When the numbers on the page were computed. Rendered in the footer, honestly. */
  updatedAt?: Date | null;
}

const { title, description, path, schema = [], canonicalTo, noindex, updatedAt } = Astro.props;
const canonical = abs(canonicalTo ?? path);

/**
 * The share card for this page.
 *
 * A city and a country get one drawn from their own numbers; everything else falls back to the
 * static file, because a guide article has no reading to put on a card and inventing one would be
 * the wrong kind of consistency.
 */
const ogSegments = path.split("/").filter(Boolean);
const ogPath =
  ogSegments.length === 1 || ogSegments.length === 2 ? `/og/${ogSegments.join("/")}.svg` : "/og.png";

const graph = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.origin,
    inLanguage: DEFAULT_LANG,
  },
  ...schema,
];
---

<!doctype html>
<html lang={DEFAULT_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      LANGS.map((lang) => (
        <link rel="alternate" hreflang={lang} href={abs(path)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={abs(path)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/*
      The card is drawn for the page rather than shared across the site. A link to Berlin and a
      link to Sofia used to look identical in a message — on a site whose whole value is the
      reading, that is the one place it has to show. `/og/<path>.svg` mirrors the page's own URL,
      so nothing has to be passed here but the path we already have.

      Dimensions are declared because several crawlers refuse to render an image they cannot size,
      and an SVG has no intrinsic pixel size to read.
    */}
    <meta property="og:image" content={abs(ogPath)} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={abs(ogPath)} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href={abs("/llms.txt")} title="llms.txt" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />

    <!--
      Theme, applied before first paint so the page never flashes the wrong one. Sets the
      attribute the tokens listen for; the OS preference wins when nothing was chosen.
    -->
    <script is:inline>
      try {
        const saved = localStorage.getItem("airsignal:theme");
        if (saved === "dark" || saved === "light") {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to the readings</a>
    <slot />

    <footer class="wrap foot">
      <div style="display:flex;gap:22px;flex-wrap:wrap;align-items:baseline">
        <span>
          Data · <a href="https://sensor.community/">Sensor.Community</a> (ODbL) ·
          <a href="https://open-meteo.com/">Open-Meteo</a> · USGS · NOAA ·
          {/* CC BY 4.0 requires the credit, and OSM's licence requires its own. Both are owed. */}
          <a href="https://www.geonames.org/">GeoNames</a> (CC BY) ·
          <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
        </span>
        {/*
          Not decoration, and not modesty. AGPL section 13 says that anyone who uses a modified
          version of this over a network is entitled to its source — which makes this link an
          obligation the licence places on us, discharged in the one place every visitor can see.
          Fork it and put it online and yours has to say the same.
        */}
        <span>
          <a href={SITE.repo}>Source</a>, AGPL-3.0
        </span>
        {
          updatedAt && (
            <span class="num">
              Computed {updatedAt.toISOString().replace("T", " ").slice(0, 16)} UTC
            </span>
          )
        }
        <button
          type="button"
          class="seg"
          id="theme-toggle"
          aria-label="Switch between light and dark"
        >
          theme
        </button>
      </div>
      <p style="margin-top:10px;font-size:12.5px">
        Comfort is one score from fourteen signals, not an AQI. Community sensors are corrected
        against the model where they disagree — <a href={SITE.repo}>the maths is open</a>, and so
        is the code.
      </p>
    </footer>

    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ??
          (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const next = current === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("airsignal:theme", next);
        } catch {}
      });
    </script>

    <!--
      Analytics is deferred and self-hosted: the page's promise is that the reading is already on
      screen, and nothing third-party gets to run before it.
    -->
    <script is:inline defer src={SITE.analytics.src} data-source={SITE.analytics.source}></script>
  </body>
</html>

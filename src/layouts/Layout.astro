---
import { SITE, DEFAULT_LANG, LANGS, EMBED_SAMPLE, abs, paths } from "../lib/site";
import "../styles/tokens.css";
import "../styles/components.css";

interface Props {
  title: string;
  description: string;
  /** Path of this page, without a trailing slash. Canonical derives from it. */
  path: string;
  /** JSON-LD nodes for the page. City and station pages always set them. */
  schema?: unknown[];
  /**
   * Where the canonical should point when it is not this page. A station below the indexing bar
   * canonicals to its city: the page is worth having, it is not worth competing with the page that
   * answers the same question better.
   */
  canonicalTo?: string;
  noindex?: boolean;
  /** When the numbers on the page were computed. Rendered in the footer, honestly. */
  updatedAt?: Date | null;
  /**
   * Whether to show the "put this on your site" strip above the footer.
   *
   * Off for a page that already makes the offer better. A city page carries the snippet for its own
   * city, pre-filled — asking again ten centimetres below it, in weaker and more general terms, is
   * two requests where the page had earned one.
   */
  pitch?: boolean;
  /**
   * Which city the strip's live badge shows, as `country/city`.
   *
   * A page that is about a place passes its own — a reader on /germany sees Stuttgart's number,
   * not a town they have never heard of, and the example stops looking like a stock photo.
   * Everything else falls back to the constant.
   */
  pitchPlace?: string;
  pitchName?: string;
}

const {
  title,
  description,
  path,
  schema = [],
  canonicalTo,
  noindex,
  updatedAt,
  pitch = true,
  pitchPlace = EMBED_SAMPLE.place,
  pitchName = EMBED_SAMPLE.name,
} = Astro.props;

// The snippet the button copies, and the one that produced the badge beside it. Built here so the
// two cannot describe different things — the whole failure mode of a "copy this" box.
const pitchSnippet =
  `<a href="${abs(`/${pitchPlace}`)}" data-airsignal="${pitchPlace}" data-airsignal-variant="badge">Air in ${pitchName}</a>` +
  `<script async src="${abs("/embed.js")}"><\/script>`;
const canonical = abs(canonicalTo ?? path);

/**
 * The share card for this page.
 *
 * A city and a country get one drawn from their own numbers; everything else falls back to the
 * static file, because a guide article has no reading to put on a card and inventing one would be
 * the wrong kind of consistency.
 */
const ogSegments = path.split("/").filter(Boolean);
const ogPath =
  ogSegments.length === 1 || ogSegments.length === 2 ? `/og/${ogSegments.join("/")}.svg` : "/og.png";

const graph = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.origin,
    inLanguage: DEFAULT_LANG,
  },
  ...schema,
];
---

<!doctype html>
<html lang={DEFAULT_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {
      LANGS.map((lang) => (
        <link rel="alternate" hreflang={lang} href={abs(path)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={abs(path)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/*
      The card is drawn for the page rather than shared across the site. A link to Berlin and a
      link to Sofia used to look identical in a message — on a site whose whole value is the
      reading, that is the one place it has to show. `/og/<path>.svg` mirrors the page's own URL,
      so nothing has to be passed here but the path we already have.

      Dimensions are declared because several crawlers refuse to render an image they cannot size,
      and an SVG has no intrinsic pixel size to read.
    */}
    <meta property="og:image" content={abs(ogPath)} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={abs(ogPath)} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href={abs("/llms.txt")} title="llms.txt" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />

    <!--
      Theme, applied before first paint so the page never flashes the wrong one. Sets the
      attribute the tokens listen for; the OS preference wins when nothing was chosen.
    -->
    <script is:inline>
      try {
        const saved = localStorage.getItem("airsignal:theme");
        if (saved === "dark" || saved === "light") {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to the readings</a>
    <slot />

    {/*
      The one thing this site asks for, asked on every page.

      Nothing links here — Google had crawled none of sixty-odd thousand pages, and a page nobody
      links to is one it has no reason to fetch twice. The measurement is the only thing here that
      another site wants, so it is the only thing worth trading for a link.

      Above the footer rather than inside it, because a request buried among licence credits is a
      request nobody reads. And open, not collapsed: the first version was one line and a link to a
      page that explained it, which asks the reader to take two steps on faith before seeing
      anything. Here the badge is live, the snippet is the one that produced it, and the button
      copies it — the whole transaction fits above the footer, and nobody has to click to find out
      what is being offered.

      Near-neutral by construction. The badge is the only coloured thing in the strip, and its
      colour is a measurement, which is the argument the whole design rests on.
    */}
    {
      // Not on the page it points at, which would be a link to where the reader already is.
      pitch && path !== paths.embed() && (
        <aside class="wrap pitch">
          <div class="pitch-head">
            <strong>Put live air quality on your own site.</strong>
            <span class="pitch-dim">One line of HTML. No key, no signup.</span>
          </div>

          <div class="pitch-row">
            {/*
              The real script, the real API, the real snippet below it. A picture of a badge would
              be a promise; this is the thing, and it breaks when the widget breaks.
            */}
            <a class="pitch-demo" href={`/${pitchPlace}`} data-airsignal={pitchPlace} data-airsignal-variant="badge">
              Air quality in {pitchName}
            </a>
            <code class="pitch-code" id="pitch-code">{pitchSnippet}</code>
            <button class="seg pitch-copy" type="button" data-pitch-copy>Copy</button>
            <a class="pitch-go" href={paths.embed()}>More variants &amp; API →</a>
          </div>
        </aside>
      )
    }

    <script is:inline>
      // Four lines rather than an island: shipping a framework to call one clipboard method would
      // cost the visitor more than the widget it is advertising.
      document.querySelector("[data-pitch-copy]")?.addEventListener("click", async (event) => {
        const button = event.currentTarget;
        const code = document.getElementById("pitch-code")?.textContent ?? "";
        try {
          await navigator.clipboard.writeText(code);
          button.textContent = "Copied";
        } catch {
          // Refused without a gesture on some browsers, and always over plain http. Select it so
          // the reader can copy it themselves rather than press a button that quietly lied.
          const node = document.getElementById("pitch-code");
          if (node) {
            const range = document.createRange();
            range.selectNodeContents(node);
            const selection = window.getSelection();
            selection?.removeAllRanges();
            selection?.addRange(range);
          }
          button.textContent = "Select and copy";
        }
        setTimeout(() => (button.textContent = "Copy"), 2400);
      });
    </script>

    {/* Only where the strip is, so no other page pays for a script it does not use. */}
    {pitch && path !== paths.embed() && <script is:inline async src="/embed.js" />}

    <footer class="wrap foot">
      <div style="display:flex;gap:22px;flex-wrap:wrap;align-items:baseline">
        <span>
          Data · <a href="https://sensor.community/">Sensor.Community</a> (ODbL) ·
          <a href="https://open-meteo.com/">Open-Meteo</a> · USGS · NOAA ·
          {/* CC BY 4.0 requires the credit, and OSM's licence requires its own. Both are owed. */}
          <a href="https://www.geonames.org/">GeoNames</a> (CC BY) ·
          <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
        </span>
        {/*
          Not decoration, and not modesty. AGPL section 13 says that anyone who uses a modified
          version of this over a network is entitled to its source — which makes this link an
          obligation the licence places on us, discharged in the one place every visitor can see.
          Fork it and put it online and yours has to say the same.
        */}
        <span>
          <a href={SITE.repo}>Source</a>, AGPL-3.0
        </span>
        {
          updatedAt && (
            <span class="num">
              Computed {updatedAt.toISOString().replace("T", " ").slice(0, 16)} UTC
            </span>
          )
        }
        <button
          type="button"
          class="seg"
          id="theme-toggle"
          aria-label="Switch between light and dark"
        >
          theme
        </button>
      </div>
      <p style="margin-top:10px;font-size:12.5px">
        Comfort is one score from fourteen signals, not an AQI. Community sensors are corrected
        against the model where they disagree — <a href={SITE.repo}>the maths is open</a>, and so
        is the code.
      </p>
    </footer>

    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ??
          (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const next = current === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("airsignal:theme", next);
        } catch {}
      });
    </script>

    <!--
      Analytics is deferred and self-hosted: the page's promise is that the reading is already on
      screen, and nothing third-party gets to run before it.
    -->
    <script is:inline defer src={SITE.analytics.src} data-source={SITE.analytics.source}></script>
  </body>
</html>

---
import { SITE, DEFAULT_LANG, abs } from "../lib/site";
import "../styles/tokens.css";

interface Props {
  title: string;
  description: string;
  /** Path of this page, always with a trailing slash. Canonical derives from it. */
  path: string;
  /** JSON-LD for the page, serialised into a script tag. City and station pages always set it. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, path, jsonLd } = Astro.props;
const canonical = abs(path);
---

<!doctype html>
<html lang={DEFAULT_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs("/og.png")} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>

  <body>
    <slot />

    <!--
      Analytics is deferred and self-hosted: the page's promise is that the reading is already on
      screen, and nothing third-party gets to run before it.
    -->
    <script is:inline defer src={SITE.analytics.src} data-source={SITE.analytics.source}></script>
  </body>
</html>

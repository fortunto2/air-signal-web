---
/**
 * The city page. The reason the rewrite exists.
 *
 * Everything a search engine needs is in this HTML before any script runs: the heading, a verdict
 * sentence containing real numbers, all fourteen readings, and JSON-LD. The island that follows
 * may refresh the numbers; it may not be the thing that produces them.
 */
import Layout from "../../../layouts/Layout.astro";
import Bar from "../../../components/Bar.astro";
import Spectrum from "../../../components/Spectrum.astro";
import Sparkline from "../../../components/Sparkline.astro";
import AirIntel from "../../../components/AirIntel.astro";
import SetPlace from "../../../components/SetPlace.tsx";
import LiveCity from "../../../components/LiveCity.tsx";
import StationMap from "../../../components/StationMap.tsx";
import Blame from "../../../components/Blame.astro";
import {
  getCity,
  getCityHistory,
  getStationsForCity,
  getNearbyCities,
  getCpf,
  getSources,
  saveCityReadings,
} from "../../../lib/db";
import { aqi, classifySource, computeComfort, detectEvent, isStale, windDirection } from "../../../lib/comfort-server";
import { cityView, ago } from "../../../lib/view";
import { EXPLAIN } from "../../../lib/explain";
import { SIGNAL_TO_SLUG } from "../../../lib/guide";
import { SITE, abs, paths, comfortBand, pmBand } from "../../../lib/site";

const { country, city: citySlug } = Astro.params;
const row = await getCity(country!, citySlug!);
if (!row) return new Response(null, { status: 404 });

const [history, stations, nearby, sources, blame] = await Promise.all([
  getCityHistory(row.id, 120),
  getStationsForCity(row.id, 24),
  getNearbyCities(row.lat, row.lon, 2, 5, row.id),
  getSources(row.id, 24),
  getCpf(row.id, 5),
]);

/**
 * On demand, not in a nightly batch over ten thousand cities.
 *
 * The first visitor to a cold page — usually a crawler — pays about half a second for four
 * upstream calls, gets a complete page, and warms it for everyone after. `waitUntil` writes the
 * result back without holding up the response, and the edge cache in src/middleware.ts means most
 * requests never reach this code at all.
 *
 * When the upstreams say no, `computeComfort` returns null and the page renders whatever the
 * database has. Yesterday's real numbers beat an error, and beat a blank page by more.
 */
let fresh = null;
if (isStale(row.updated_at)) {
  fresh = await computeComfort(row.lat, row.lon);
  if (fresh) {
    row.comfort = fresh.total;
    row.worst_signal = (fresh.worst ?? null) as typeof row.worst_signal;
    row.signals_json = JSON.stringify(fresh.scores);
    row.readings_json = JSON.stringify(fresh.readings);
    row.updated_at = new Date().toISOString();

    Astro.locals.cfContext?.waitUntil(
      saveCityReadings(row.id, {
        comfort: fresh.total,
        worstSignal: fresh.worst ?? null,
        signals: fresh.scores as Record<string, number>,
        readings: fresh.readings,
      }).catch(() => {
        // A failed write costs the next visitor one recomputation. It is not worth a 500.
      }),
    );
  }
}

const v = cityView(row, history);
const scores = v.scores;

// Everything below comes out of the Rust core, from data already on this page — no extra request.
// The event baseline is the median of the city's own devices, which is what lets it run at all.
const airEvent = detectEvent(
  v.lat,
  v.lon,
  stations.map((s) => ({ id: s.id, lat: s.lat, lon: s.lon, pm25: s.pm25, pm10: s.pm10 })),
);
// The devices are the fallback for both, and often the better source: they are measurements, and
// they keep working when the model upstream is rate-limited or down. `detect_event` has already
// computed the medians, so this costs nothing.
const pm25Now = v.readings.pm25 ?? airEvent?.median_pm25 ?? null;
const pm10Now = v.readings.pm10 ?? airEvent?.median_pm10 ?? null;

const airSource = classifySource(pm25Now, pm10Now);
const airAqi = aqi(pm25Now, pm10Now);
const compass = windDirection(v.readings.wind_dir);
const wind = compass ? { ...compass, speed: v.readings.wind } : null;

// Where today sits in its own month. A number is only meaningful next to the ones before it.
const past = history.map((d) => d.comfort).filter((n): n is number => n !== null);
const better =
  past.length > 6 && v.comfort !== null
    ? Math.round((past.filter((p) => p < v.comfort!).length / past.length) * 100)
    : null;

const live = stations.filter((s) => s.pm25 !== null).length;

/**
 * The map's window, sized to the devices rather than to a fixed radius.
 *
 * Sofia's 283 sensors sit inside 12 km; a town with three has them 30 km apart. A constant box
 * would either crop the first or lose the second in an empty field, so the frame follows the data
 * and is only clamped at the ends to stop one stray device 200 km away from zooming the whole city
 * out to a dot.
 */
const spread = stations.reduce((max, s) => Math.max(max, s.distance_km ?? 0), 0);
const spanKm = Math.min(45, Math.max(9, spread * 1.25));
// A degree of longitude shrinks with latitude; without the cosine the box is far too wide in
// Scandinavia and too narrow near the equator.
const dLat = spanKm / 111;
const dLon = dLat / Math.max(0.2, Math.cos((v.lat * Math.PI) / 180));
const bbox: [number, number, number, number] = [
  v.lon - dLon,
  v.lat - dLat,
  v.lon + dLon,
  v.lat + dLat,
];

// The arrow only means something with a direction; speed may be absent and the arrow still reads.
const windArrow =
  v.readings.wind_dir !== undefined && compass
    ? { fromDeg: v.readings.wind_dir, kmh: v.readings.wind ?? 0, label: compass.label }
    : null;

// Only when the devices genuinely cluster on one side. A scattered anomaly drawn as a wedge would
// be the site asserting a direction it does not have — the exact false confidence `detect_event`
// exists to prevent.
const plume = airEvent?.directional?.is_directional
  ? {
      bearingDeg: airEvent.directional.bearing_deg,
      spreadDeg: airEvent.directional.spread_deg,
      label: `to the ${airEvent.directional.bearing_label}`,
    }
  : null;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Place",
    name: `${v.name}, ${v.country}`,
    url: abs(v.path),
    geo: { "@type": "GeoCoordinates", latitude: v.lat, longitude: v.lon },
  },
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: `Air quality and outdoor comfort in ${v.name}`,
    description: v.description,
    url: abs(v.path),
    temporalCoverage: history.length ? `${history[0]!.day}/${history.at(-1)!.day}` : undefined,
    variableMeasured: v.signals
      .filter((s) => s.measure !== null)
      .map((s) => ({ "@type": "PropertyValue", name: s.name, value: s.measure })),
    isBasedOn: [
      { "@type": "Dataset", name: "Sensor.Community", url: "https://sensor.community/" },
      { "@type": "Dataset", name: "Open-Meteo", url: "https://open-meteo.com/" },
    ],
    license: "https://opendatacommons.org/licenses/odbl/",
    creator: { "@type": "Organization", name: SITE.name, url: SITE.origin },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Countries", item: abs(paths.countries()) },
      { "@type": "ListItem", position: 2, name: v.country, item: abs(paths.country(row.country_slug)) },
      { "@type": "ListItem", position: 3, name: v.name, item: abs(v.path) },
    ],
  },
];
---

<Layout
  title={v.title}
  description={v.description}
  path={v.path}
  schema={schema}
  updatedAt={v.updatedAt}
>
  <main class="wrap" style="padding-top:22px" id="main">
    <div class="app">
      <Bar>
        <div style="font-size:13.5px;color:var(--ink-3)">
          <a href={paths.country(row.country_slug)} style="color:var(--accent);text-decoration:none">
            {v.country}
          </a> · {v.name}
        </div>
      </Bar>

      <div style="padding:24px 20px 8px">
        <div class="eyebrow">Air &amp; comfort in</div>
        <h1 style="font-size:27px;margin:5px 0 0">{v.name}, {v.country}</h1>
        <p style="margin-top:9px;max-width:60ch;font-size:14.5px">{v.verdict}</p>
      </div>

      <div class="readout" style="padding-top:16px">
        <div>
          {/*
            AQI leads, comfort follows.
            //
            The site's argument has not changed: a person does not go outside for PM2.5, and one
            index cannot say "the air is clean but the UV will burn you". But an argument is what
            you make *after* answering the question the reader arrived with, and they arrived
            asking what the air quality is. AQI is the number they know, it is absolute, and it is
            comparable across every site and every season — where the comfort score, in a European
            summer, puts nearly everything above 85 and separates almost nothing.

            So AQI is the headline and comfort is the second opinion beside it: the thing this site
            adds, rather than the thing it opens with.
          */}
          <div class="score">
            <div class:list={["value", airAqi && `fg-${pmBand(pm25Now)}`]} data-live="aqi">
              {airAqi?.aqi ?? "—"}
            </div>
            <div class="of">US AQI</div>
          </div>
          <div class="verdict">
            <div class:list={["word", airAqi && `fg-${pmBand(pm25Now)}`]}>
              {airAqi?.label ?? v.word}
            </div>

            {/*
              Two comparisons, and they answer different questions. Against this city's own past
              month, and against every other city that is actually measured.

              The second exists because the absolute score stopped separating places: a European
              summer puts nearly everything above 85, so "Excellent" is true and says almost
              nothing. A rank spreads what the scale compresses.
            */}
            <div class="where">
              {
                better !== null
                  ? `Better than ${better} % of the past ${past.length} days`
                  : `${v.stationCount} sensor${v.stationCount === 1 ? "" : "s"} within reach`
              }
              {
                row.percentile !== null && (
                  <>
                    {" · "}
                    <span class="num">{row.percentile}</span>
                    {"th percentile of measured cities"}
                  </>
                )
              }
            </div>

            {/*
              The absolute number, beside the relative one. A percentile moves when the network
              moves; AQI 30 is AQI 30 in Sofia in August and in Delhi in November, and it is what
              every other site prints. The comfort score is ours and the AQI is everyone's, so both
              belong where the reader looks first.
            */}
            {/* The second opinion: our own score, and the reading the AQI was derived from. */}
            <div class="hero-aqi">
              {pm25Now !== null && <span class="eyebrow num">{pm25Now} µg/m³ PM2.5</span>}
              {
                v.comfort !== null && (
                  <>
                    <span class="eyebrow">·</span>
                    <span class="eyebrow">comfort</span>
                    <span
                      class:list={["num", v.band && `fg-${v.band}`]}
                      style="font-size:19px"
                      data-live="comfort"
                    >
                      {v.comfort}
                    </span>
                    <span class="eyebrow">/100 from fourteen signals</span>
                  </>
                )
              }
            </div>
          </div>
          <div style="margin-top:14px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <SetPlace
              client:idle
              name={v.name}
              country={v.country}
              path={v.path}
              lat={v.lat}
              lon={v.lon}
            />
            {
              live > 0 ? (
                <span class:list={["chip", v.band && `fg-${v.band}`]}>
                  <span class="dot" />
                  {live} sensor{live === 1 ? "" : "s"} live
                </span>
              ) : (
                <span class="chip fg-quiet">
                  <span class="dot" />
                  modelled — no sensor here
                </span>
              )
            }
          </div>
        </div>

        <div>
          <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:9px">
            <div class="eyebrow">Signal spectrum</div>
            <div class="eyebrow" data-live="stamp">
              {v.updatedAt ? `Updated ${ago(v.updatedAt)}` : ""}
            </div>
          </div>
          <Spectrum scores={scores} size="hero" />
          <div style="height:20px"></div>
        </div>
      </div>

      <AirIntel aqi={airAqi} source={airSource} event={airEvent} wind={wind} placeName={v.name} />

      <div class="grid-signals">
        {
          v.signals.map((s) => (
            <div class:list={["sig", s.measure === null && "is-absent"]}>
              {/*
                The name is the trigger. A reader looking at "Geomagnetic 96" has no way to know
                what that is or whether 96 is good, and the answer used to live only in the method
                page. It opens on hover and on focus, so a keyboard and a thumb both reach it.

                Short on purpose: what it is, where the number sits on the curve, and a link. The
                long version lives in the guide once rather than on ten thousand city pages.
              */}
              <button class="name has-help" type="button" aria-describedby={`h-${s.key}`}>
                {s.name}
                <svg width="11" height="11" viewBox="0 0 16 16" aria-hidden="true" class="help-mark">
                  <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.4" />
                  <path
                    d="M6 6a2 2 0 1 1 2.6 1.9c-.4.2-.6.5-.6.9v.4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                  />
                  <circle cx="8" cy="11.6" r="0.9" fill="currentColor" />
                </svg>
              </button>
              <span class="help" id={`h-${s.key}`} role="tooltip">
                <b>{EXPLAIN[s.key].what}</b>
                <span class="help-scale num">{EXPLAIN[s.key].scale}</span>
                <span class="help-meta">
                  {Math.round(EXPLAIN[s.key].weight * 100)} % of the score ·{" "}
                  {EXPLAIN[s.key].source} ·{" "}
                  <a href={paths.guideEntry(SIGNAL_TO_SLUG[s.key])}>what this means</a>
                </span>
              </span>
              <div class="reading">
                <span class:list={["measure", s.band && `fg-${s.band}`]}>
                  {s.measure ?? "no reading"}
                </span>
                <span class="pts">{s.score !== undefined ? `${s.score}` : "—"}</span>
              </div>
              <div class="track">
                {s.score !== undefined && (
                  <i class={`scale-${s.band}`} style={`width:${s.score}%`} />
                )}
              </div>
            </div>
          ))
        }
      </div>

      {
        history.length > 2 && (
          <div style="padding:18px 20px 22px;border-bottom:1px solid var(--line-soft)">
            {/*
              Only the average here. The chart's own header already prints the range and replaces it
              with the value under the pointer, so min and max were the same two numbers twice, one
              line apart — and the mean is the one the range does not give you.
            */}
            <div style="display:flex;justify-content:space-between;align-items:baseline">
              <div class="eyebrow">Comfort, last {history.length} days</div>
              <div class="eyebrow num">
                average {Math.round(past.reduce((a, b) => a + b, 0) / past.length)}
              </div>
            </div>
            <Sparkline
              points={history.map((d) => d.comfort)}
              labels={history.map((d) => d.day)}
              band={v.band ?? undefined}
              unit="/100"
              floor={100}
              label={`Comfort in ${v.name} over the last ${history.length} days`}
            />
          </div>
        )
      }

      {
        v.divergence !== null && v.divergence > 1.3 && (
          <div style="padding:16px 20px;border-bottom:1px solid var(--line-soft)">
            <div class="eyebrow" style="margin-bottom:8px">
              Sensors versus the model
            </div>
            <div style="display:flex;align-items:baseline;gap:8px">
              <span class="num fg-fair" style="font-size:23px">
                ×{v.divergence.toFixed(1)}
              </span>
              <span style="font-size:13px;color:var(--ink-2)">apart</span>
            </div>
            <p style="font-size:12.5px;margin-top:8px;max-width:70ch">
              The community sensors here and the atmospheric model disagree by that factor. Where
              they do, the sensors win and the model is down-weighted — a cheap device indoors or
              beside a road reads several times high, and plotting that at face value is what every
              other air map does.
            </p>
          </div>
        )
      }

      {
        stations.length > 0 && (
          <div style="border-bottom:1px solid var(--line-soft)">
            <div style="padding:16px 20px 10px">
              <div class="eyebrow">Where the sensors are</div>
              <p style="font-size:13px;margin-top:6px;max-width:74ch">
                Each dot is a device, coloured by what it is reading right now and hollow if it has
                gone quiet.
                {windArrow &&
                  ` The line is the wind — it comes from the ${windArrow.label} and crosses the city
                    towards the arrow.`}
                {plume &&
                  ` The shaded wedge is where the high readings are clustered, which is the side
                    something is arriving from.`}
                {sources.length > 0 &&
                  ` The hollow rings are what OpenStreetMap has mapped nearby — works, power plants,
                    industrial land and major roads. Nothing is measured at those points; whether
                    any of it reaches the city depends on the wind.`}
              </p>
            </div>
            {/*
              `client:only` for the same reason as the main map: MapLibre reads `window` at module
              scope, so there is nothing for the server to render. The list below is the answer for
              anyone who never runs it — the map is the picture, not the data.
            */}
            <StationMap
              client:only="react"
              centre={[v.lon, v.lat]}
              zoom={11}
              bbox={bbox}
              spanKm={spanKm}
              wind={windArrow}
              plume={plume}
              sources={sources.map((s) => ({
                name: s.name,
                kind: s.kind,
                lat: s.lat,
                lon: s.lon,
                distanceKm: s.distance_km,
              }))}
              inset
            />
          </div>
        )
      }

      <Blame rows={blame} placeName={v.name} />

      {
        stations.length > 0 && (
          <div style="padding:16px 20px 20px;border-bottom:1px solid var(--line-soft)">
            <div class="eyebrow" style="margin-bottom:10px">
              The {stations.length} sensor{stations.length === 1 ? "" : "s"} this was computed from
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:7px 20px">
              {stations.map((s) => (
                <a class="near" href={paths.station(row.country_slug, row.slug, s.id)}>
                  <span class="nm">
                    Station {s.id}
                    {s.sensor_type && (
                      <span style="color:var(--ink-3)"> · {s.sensor_type.toUpperCase()}</span>
                    )}
                  </span>
                  <span class="km">{s.distance_km !== null ? `${s.distance_km} km` : ""}</span>
                  <span class:list={["pm", `fg-${pmBand(s.pm25)}`]}>
                    {s.pm25 !== null ? s.pm25.toFixed(1) : "—"}
                  </span>
                </a>
              ))}
            </div>
          </div>
        )
      }

      {
        nearby.length > 0 && (
          <div style="padding:16px 20px 20px">
            <div class="eyebrow" style="margin-bottom:10px">
              Nearby
            </div>
            <div style="display:flex;gap:10px;flex-wrap:wrap">
              {nearby.map((c) => (
                <a
                  class="seg"
                  style="text-decoration:none"
                  href={paths.city(c.country_slug, c.slug)}
                >
                  {c.name}
                  {c.comfort !== null && (
                    <span class={`fg-${comfortBand(c.comfort)}`}> {c.comfort}</span>
                  )}
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>

    <!--
      The island. It refreshes what is already above it and nothing more — if this never runs, the
      page is still complete and still correct as of the last ingest.
    -->
    <LiveCity client:idle lat={v.lat} lon={v.lon} computedAt={v.updatedAt?.toISOString() ?? null} />
  </main>
</Layout>

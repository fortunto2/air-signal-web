---
/**
 * Everywhere with sensors, ordered by comfort.
 *
 * This is the page that proves the mini spectrum survives being shrunk into a list row — the
 * argument for choosing that glyph over a ring. It is also the most useful screen for the second
 * audience in the PRD: someone comparing three towns before deciding where to spend a winter.
 */
import Layout from "../layouts/Layout.astro";
import Bar from "../components/Bar.astro";
import Spectrum from "../components/Spectrum.astro";
import SortBar from "../components/SortBar.astro";
import {
  CITY_SORTS,
  RANK_MIN_SENSORS,
  citySort,
  countCitiesWithSensors,
  countRankable,
  getLastIngest,
  getRankedCities,
  getSitemapCounts,
  parseSignals,
} from "../lib/db";
import { comfortBand, pm25Aqi, pmBand, SITE, abs, paths } from "../lib/site";

import { ago } from "../lib/view";

const LIMIT = 150;
const sort = citySort(Astro.url.searchParams.get("sort"));

/**
 * Cities with one or two devices are out by default.
 *
 * 420 of the 904 scored cities have exactly one. A single fifty-euro sensor is a reading about the
 * balcony it sits on, and putting that next to Sofia's 252 in the same numbered list invites a
 * comparison the data cannot support. `?thin=1` puts them back, marked.
 */
const includeThin = Astro.url.searchParams.get("thin") === "1";
const minSensors = includeThin ? 1 : RANK_MIN_SENSORS;

const [ranked, total, rankable, counts, lastIngest] = await Promise.all([
  getRankedCities(LIMIT, sort, minSensors),
  countCitiesWithSensors(),
  countRankable(),
  getSitemapCounts(),
  getLastIngest(),
]);

/**
 * How far apart the top and the bottom of this list actually are.
 *
 * Computed rather than assumed, because right now it is three points across a hundred and fifty
 * cities, and a league table whose ends are indistinguishable should say so instead of implying an
 * order it does not have. If the spread widens — a smoke season, a winter inversion — the sentence
 * disappears on its own.
 */
const scores = ranked.map((c) => c.comfort).filter((n): n is number => n !== null);
const spread = scores.length > 1 ? Math.max(...scores) - Math.min(...scores) : null;
const flat = sort === "best" || sort === "worst" ? spread !== null && spread <= 8 : false;

/** Too few to be a ranking. Say so rather than presenting three rows as a league table. */
const sparse = rankable.eligible < 20;

const SORT_COPY: Record<typeof sort, { h1: string; lede: string; title: string }> = {
  best: {
    h1: "Ranked by comfort, right now",
    title: `Air Quality Ranking — Cities Compared Today`,
    lede: "One score from fourteen signals, for every city where community sensors are reporting.",
  },
  worst: {
    h1: "The least comfortable, right now",
    title: `Worst Air Quality Today — Cities Ranked`,
    lede:
      "The same fourteen signals, from the bottom. A low score is usually one signal doing the " +
      "damage rather than everything being bad at once — the spectrum beside each row shows which.",
  },
  cleanest: {
    h1: "Cleanest air, right now",
    title: `Cleanest Air in the World Right Now — Cities Ranked`,
    lede:
      "Ordered by the median PM2.5 across each city's community sensors — measured, not modelled, " +
      "which is why only cities with devices appear.",
  },
  dirtiest: {
    h1: "Dirtiest air, right now",
    title: `Most Polluted Cities Right Now — Live PM2.5`,
    lede:
      "Ordered by the median PM2.5 across each city's community sensors. These are the places " +
      "where the fine particulate reading is highest at this moment, not on annual average.",
  },
  sensors: {
    h1: "Best measured, right now",
    title: `Cities With the Most Air Quality Sensors`,
    lede:
      "Where the community network is densest. More devices means the city median is a " +
      "measurement rather than an estimate from one box on one street.",
  },
};

const copy = SORT_COPY[sort];

const description =
  `Every city with community air sensors, ranked by outdoor comfort — ${total} places scored on ` +
  "air, temperature, wind, sea, UV, pollen and eight more signals.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Cities ranked by outdoor comfort",
    numberOfItems: total,
    itemListElement: ranked.slice(0, 25).map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.name,
      url: abs(paths.city(c.country_slug, c.slug)),
    })),
  },
];
---

<Layout
  title={copy.title}
  description={description}
  path="/ranking"
  schema={schema}
  updatedAt={lastIngest}
>
  <main class="wrap" style="padding-top:22px" id="main">
    <div class="app">
      <Bar>
        <div class="eyebrow">
          {total} cities with sensors
          {lastIngest && ` · updated ${ago(lastIngest)}`}
        </div>
      </Bar>

      <div style="padding:22px 20px 10px">
        <h1 style="font-size:27px;margin:0">{copy.h1}</h1>
        <p style="margin-top:9px;max-width:62ch;font-size:14.5px">
          {copy.lede} The fourteen bars beside each row are that city's spectrum — the same glyph
          as the hero, at 22 px, which is the reason it was chosen over a dial.
        </p>

        {/*
          A ranking of three cities is not a ranking, and showing one without saying why reads as a
          broken page rather than an incomplete one. Scores arrive per city — on the nightly pass,
          or the moment someone opens a city page — so the honest thing is to say how far along it
          is and point at the surfaces that are already complete.
        */}
        {
          sparse && (
            <p style="margin-top:14px;max-width:62ch;font-size:13.5px;color:var(--ink-2)">
              Only {total} of the {counts.cities.toLocaleString("en-US")} cities have been scored so
              far — the model upstream has a daily ceiling, so scores fill in as pages are opened
              and on the nightly pass. The sensor readings are complete either way:{" "}
              <a href={paths.map()} style="color:var(--accent)">the map</a> and{" "}
              <a href={paths.countries()} style="color:var(--accent)">the countries</a> have all
              {" "}{counts.stations.toLocaleString("en-US")} of them.
            </p>
          )
        }
      </div>

      {/*
        The honest caveat, printed when it is true and absent when it is not.

        A hundred and fifty cities inside three points is not an order, and a reader scanning a
        numbered list will read one anyway. Saying so costs a sentence and is the difference
        between a ranking and a ranking-shaped thing.
      */}
      {
        flat && (
          <div style="padding:0 20px 14px">
            <p style="font-size:13px;max-width:70ch;color:var(--ink-2)">
              These {ranked.length} cities span {spread} point{spread === 1 ? "" : "s"}. That is
              inside the noise: most of this network is in Europe, it is summer, and the air is
              genuinely clean almost everywhere it is measured. Read the order as a grouping, not a
              league table — and{" "}
              <a href="/ranking?sort=dirtiest" style="color:var(--accent)">sort by PM2.5</a>, which
              is the signal that actually varies right now.
            </p>
          </div>
        )
      }

      <SortBar
        options={Object.fromEntries(Object.entries(CITY_SORTS).map(([k, v]) => [k, v.label]))}
        active={sort}
        base="/ranking"
        keep={includeThin ? { thin: "1" } : {}}
      />

      <div class="sortbar" style="border-top:0;padding-top:0">
        <span class="eyebrow">Devices</span>
        <a class:list={["seg", !includeThin && "is-on"]} href={`/ranking${sort === "best" ? "" : `?sort=${sort}`}`}>
          {RANK_MIN_SENSORS}+ only
        </a>
        <a
          class:list={["seg", includeThin && "is-on"]}
          href={`/ranking?thin=1${sort === "best" ? "" : `&sort=${sort}`}`}
          rel="nofollow"
        >
          include 1–2 ({rankable.thin})
        </a>
      </div>

      <div class="rows">
        {/*
          One shape for every list on the site. The header rides the row grid so each label sits
          over its column, and the AQI is a heading rather than a unit repeated under every number.
        */}
        <div class="row is-head">
          <span />
          <span class="eyebrow">"City"</span>
          <span />
          <span class="eyebrow">AQI</span>
          <span class="eyebrow">Comfort</span>
        </div>

        {
          ranked.map((c, i) => (
            <a class="row" href={paths.city(c.country_slug, c.slug)}>
              <span class="rank num">{i + 1}</span>
              <span>
                <span class="city">{c.name}</span>{" "}
                <span class="country">
                  {c.country} ·{" "}
                  <span class:list={[c.station_count < 3 && "thin-sensors"]}>
                    {c.station_count} sensor{c.station_count === 1 ? "" : "s"}
                  </span>
                  {c.pm25_median !== null && (
                    <span class={`fg-${pmBand(c.pm25_median)}`}>
                      {" "}
                      · {c.pm25_median.toFixed(1)} µg/m³
                    </span>
                  )}
                  {c.percentile !== null && <span> · {c.percentile}th pct</span>}
                </span>
              </span>
              <Spectrum
                scores={parseSignals(c.signals_json)}
                size="mini"
                caption={`${c.name}: comfort ${c.comfort} out of 100`}
              />
              <span class:list={["n", c.comfort !== null && `fg-${comfortBand(c.comfort)}`]}>
                {c.comfort}
              </span>
            </a>
          ))
        }
      </div>

      {
        total > ranked.length && (
          <div style="padding:14px 20px 18px">
            <p class="eyebrow">
              Showing the first {ranked.length} of {total}. The rest are reachable from{" "}
              <a href={paths.map()} style="color:var(--accent)">
                the map
              </a>
              .
            </p>
          </div>
        )
      }
    </div>
  </main>
</Layout>

---
/**
 * Crews: a smoke and heat shift plan for outdoor work in California.
 *
 * A plain GET form, rendered on the server, so the plan is in the HTML for a reader with no
 * JavaScript and for a crawler alike. The maths is `airq-core` (`crew.rs`) through `lib/crew.ts`;
 * this file only lays it out. With no `place` the page plans Sacramento, so it is never empty.
 */
import Layout from "../layouts/Layout.astro";
import Bar from "../components/Bar.astro";
import CrewMap from "../components/CrewMap.tsx";
import { SITE, abs, aqiBand, paths } from "../lib/site";
import {
  REPORT_LABELS,
  agenciesFor,
  crewDate,
  crewDefaultDate,
  crewPlanAt,
  describeFrom,
  formatShift,
  geocode,
  minutesSince,
  parseShift,
  ptClock,
  ptTime,
  siteKeys,
  CREW_TZ,
  type CrewAnswer,
} from "../lib/crew";
import { REPORT_KINDS, listCrewReports, type CrewReport } from "../lib/db";
import { BACKUP_MARGIN, backupHours, backupSizing } from "../lib/battery";

const DEFAULT_PLACE = "Sacramento";
const REPO = "https://github.com/fortunto2/stanford-cleantech-2026";

const qs = Astro.url.searchParams;
const place = qs.get("place")?.trim() || DEFAULT_PLACE;
// Two selects on the form (start, end); `shift=07-17` still works for links and the app.
const shift = qs.get("start") && qs.get("end") ? parseShift(`${qs.get("start")}-${qs.get("end")}`) : parseShift(qs.get("shift"));
const hours = Array.from({ length: 25 }, (_, h) => h);
const hourLabel = (h: number) => `${String(h).padStart(2, "0")}:00`;
const shiftRaw = formatShift(shift);

// Reports change by the minute and belong to one site, so this page is never shared from the edge
// cache. The upstream forecast and the fire and monitor files are cached on their own (lib/crew.ts).
Astro.response.headers.set("cache-control", "no-store");

// The place resolves once; its zone decides which day is "today" and which three the form offers;
// then the plan and the site's reports load side by side.
let answer: CrewAnswer | null = null;
let failure: string | null = null;
let reports: CrewReport[] = [];
let tz = CREW_TZ;
let days = [0, 1, 2].map((d) => crewDate(d, tz));
let date = days.includes(qs.get("date") ?? "") ? qs.get("date")! : crewDefaultDate(tz);
try {
  const at = await geocode(place);
  if (!at) failure = `We could not find “${place}”. Try a city or town name.`;
  else {
    tz = at.tz || CREW_TZ;
    days = [0, 1, 2].map((d) => crewDate(d, tz));
    date = days.includes(qs.get("date") ?? "") ? qs.get("date")! : crewDefaultDate(tz);
    [answer, reports] = await Promise.all([
      crewPlanAt(at, date, shift),
      listCrewReports(siteKeys(at), date).catch(() => [] as CrewReport[]),
    ]);
  }
} catch (e) {
  failure = /no ground monitor/.test(String(e))
    ? "The air forecast service is down right now and there is no ground monitor within 100 km of this place. Try the nearest town in the valley."
    : "The forecast service did not answer. Try again in a minute.";
  Astro.response.status = 502;
}

const plan = answer?.plan;
const sent = Number(qs.get("sent")) || null;
const handled = Number(qs.get("handled")) || null;
const ESCALATE_AFTER_MIN = 30;
// Each row's derived facts, once, here rather than in the markup.
const agency = answer ? agenciesFor(answer.place)[0]!.name : "Cal/OSHA";
const rows = reports.map((r) => ({
  ...r,
  label: REPORT_LABELS[r.kind],
  age: minutesSince(r.created_at),
  from: describeFrom(r.evidence_json ? JSON.parse(r.evidence_json)?.from : null),
}));
const clock = (t: string) => t.slice(11, 16);
const dayLabel = (d: string) =>
  new Intl.DateTimeFormat("en-US", { weekday: "long", month: "short", day: "numeric", timeZone: "UTC" }).format(
    new Date(`${d}T12:00:00Z`),
  );
const LEVEL = {
  "sensor-confirmed": { label: "Checked against a ground monitor", band: "good" },
  "model-adjusted": { label: "Corrected by a ground monitor", band: "fair" },
  "model-only": { label: "Model only", band: "quiet" },
} as const;
const heatBand = (f: number | undefined) =>
  f === undefined ? "quiet" : f >= 95 ? "bad" : f >= 80 ? "fair" : "good";
const apiUrl = answer ? paths.crewApi(place, date, shiftRaw) : paths.crewApi("Fresno", undefined, "07-17");
const icsUrl = paths.crewPlanIcs(place, date, shiftRaw);
// Backup battery for the house: three presets × the hours the grid is dearest or an alert lasts.
const home = answer?.home ?? null;
const backup = home && answer ? backupHours(home, answer.alerts) : null;
const battery = backup ? backupSizing(backup.hours) : [];
const batteryWhy = backup
  ? `Hours: ${backup.basis}. Typical running draws, ${Math.round(BACKUP_MARGIN * 100)}% margin for inverter losses, rounded up to 0.1 kWh. Arithmetic, not a load study: a fridge with a warm kitchen or a CPAP with a humidifier draws more.`
  : "";

const pageUrl = abs(paths.crewPlan(place, date, shiftRaw));
// The grid's typical carbon by hour, under the price bar: a pattern from CAISO's last days, said so.
const co2 = answer?.grid_co2 ?? null;
const co2At = (time: string) => co2?.g_per_kwh[time.slice(11, 13)];
const co2Legend = co2 ? ` Grey: typical grid CO₂ at this hour, g/kWh, ${co2.basis} (CAISO).` : "";
const madeAt = ptTime(new Date().toISOString());
// The printed record of how the AQI was determined, for the employer's file (§5141.1(c), Appendix A).
const determination = (() => {
  if (!answer || !plan) return "";
  const g = plan.confidence.ground;
  const fire = plan.confidence.fire && plan.confidence.fire.nearest_km <= 50 ? ` VIIRS fire ${Math.round(plan.confidence.fire.nearest_km)} km ${plan.confidence.fire.direction}: a worksite reading is advised.` : "";
  if (answer.fallback) return `Held at the AirNow monitor ${answer.fallback.monitor} (latest reading); forecast service unavailable.${fire}`;
  const check = g ? `, checked against AirNow monitor ${g.nearest}, ${g.nearest_km} km (${g.pm25} µg/m³ at ${g.time.slice(11, 16)})` : ", no AirNow monitor within 25 km";
  return `Forecast PM2.5 (Open-Meteo CAMS) as an EPA NowCast${check}.${fire}`;
})();

const description =
  "Smoke and heat shift plan for farm, contractor and utility line crews in California: enter a place " +
  "and a shift, get the hour Cal/OSHA requires N95s (§5141.1, AQI 151) or shade and water (§3395, 80°F), " +
  "from an hourly forecast with the EPA NowCast, and a record of how the AQI was determined.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: `${SITE.name} for crews`,
    description,
    url: abs(paths.crew()),
    applicationCategory: "BusinessApplication",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
];
---

<Layout title={`Smoke and heat shift plan for outdoor crews — ${SITE.name}`} description={description} path={paths.crew()} schema={schema} pitch={false}>
  <main class="wrap" style="padding-top:22px" id="main">
    <div class="app">
      <Bar />

      <div style="padding:24px 20px 8px">
        <div class="eyebrow">For crews · California</div>
        <h1 style="font-size:27px;margin:5px 0 0">The hour Cal/OSHA’s smoke and heat rules start on your shift</h1>
        <p class="lede no-print" style="margin-top:12px;font-size:15.5px">
          Cal/OSHA wants N95s handed out once the air hits AQI 151, and shade and water at 80°F,
          for a farm, contractor or utility line crew alike. Type where the crew works and when the
          shift runs, and you get the hour each rule starts, the clear window for the heavy work,
          and a record of how the AQI was determined.
        </p>
      </div>

      <form class="crew-form no-print" method="get" action={paths.crew()}>
        <label>
          <span class="eyebrow">Place</span>
          <span class="crew-place">
            <input name="place" data-place value={place} placeholder="Fresno, or a town near the field" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="crew-places" required />
            <span class="results" id="crew-places" role="listbox" hidden></span>
          </span>
          <button type="button" class="crew-locate" data-locate>Use my location</button>
        </label>
        <label>
          <span class="eyebrow">Day</span>
          <select name="date">
            {days.map((d) => <option value={d} selected={d === date}>{dayLabel(d)}</option>)}
          </select>
        </label>
        <label>
          <span class="eyebrow">From</span>
          <select name="start">
            {hours.slice(0, 24).map((h) => <option value={h} selected={h === shift.start}>{hourLabel(h)}</option>)}
          </select>
        </label>
        <label>
          <span class="eyebrow">To</span>
          <select name="end">
            {hours.slice(1).map((h) => <option value={h} selected={h === shift.end}>{hourLabel(h)}</option>)}
          </select>
        </label>
        <button type="submit">Plan the shift</button>
      </form>

      {failure && <p class="crew-note" role="alert">{failure}</p>}

      {
        answer && plan && (
          <>
            <div class="crew-head">
              <div>
                <div class="eyebrow">{dayLabel(date)} · {shiftRaw.replace("-", ":00–")}:00</div>
                <h2 style="margin-top:4px">{answer.place.name}</h2>
              </div>
              <div class="crew-peaks">
                <a class="crew-print no-print" href={icsUrl} download>Add to calendar (.ics)</a>
                <button class="crew-print no-print" type="button" onclick="window.print()">Print / Save PDF</button>
                <span>
                  <span class="eyebrow">Peak AQI</span>
                  <b class={`num fg-${aqiBand(plan.peak_aqi)}`}>{plan.peak_aqi ?? "–"}</b>
                </span>
                <span>
                  <span class="eyebrow">Peak</span>
                  <b class={`num fg-${heatBand(plan.peak_temp_f ?? undefined)}`}>
                    {plan.peak_temp_f === null ? "–" : `${Math.floor(plan.peak_temp_f)}°F`}
                  </b>
                </span>
              </div>
            </div>

            {answer.fallback && (
              <p class="crew-note">
                The air forecast service is down right now, so this plan holds the air at the nearest
                ground monitor’s latest reading ({answer.fallback.monitor}) instead of
                forecasting it{answer.fallback.temp === "nws" ? "; temperatures are the National Weather Service forecast" : answer.fallback.temp === "none" ? "; no temperature forecast was available" : ""}.
                Check again before the afternoon.
              </p>
            )}
            {answer.place.country === "US" && answer.place.state && answer.place.state !== "California" && (
              <p class="crew-note">These are California’s rules. {answer.place.state} may have its own; complaints there go to {agenciesFor(answer.place)[0]!.name}.</p>
            )}
            {answer.place.country !== "US" && (
              <p class="crew-note">No workplace smoke or heat rulebook for this country yet: the hours show the forecast and the checks, without legal thresholds. Hours are local to the place ({answer.place.tz}).</p>
            )}
            <div class="crew-check">
              <span class={`crew-level fg-${LEVEL[plan.confidence.level].band}`}>{LEVEL[plan.confidence.level].label}</span>
              {plan.confidence.notes.map((n) => <p class={n.startsWith("Active fire") ? "crew-fire" : ""}>{n}</p>)}
              {!plan.confidence.fire || plan.confidence.fire.nearest_km > 50 ? (
                <p>
                  {plan.confidence.fire
                    ? `Nearest VIIRS fire detection is ${Math.round(plan.confidence.fire.nearest_km)} km ${plan.confidence.fire.direction} (last 24 h).`
                    : "No VIIRS fire detections within about 200 km in the last 24 h."}
                </p>
              ) : null}
              <p class={answer.alerts.some((a) => /Red Flag|Heat|Air Quality|Smoke/i.test(a.event)) ? "crew-fire" : ""}>
                {answer.alerts.length
                  ? `National Weather Service alerts here now: ${answer.alerts.map((a) => a.event + (a.ends ? ` until ${a.ends.slice(5, 16).replace("T", " ")}` : "")).join("; ")}.`
                  : "No National Weather Service alerts for this place right now (Red Flag Warning, Heat Advisory, Air Quality Alert)."}
              </p>
            </div>

            <ol class="crew-actions">
              {plan.actions.length === 0 && (
                <li>
                  <span class="num">all day</span>
                  <span>No smoke or heat thresholds crossed. Normal shift.</span>
                  <span />
                </li>
              )}
              {plan.actions.map((a) => (
                <li>
                  <span class="num">{clock(a.time)}</span>
                  <span>{a.text}</span>
                  <span class="cite">{a.cite}</span>
                </li>
              ))}
            </ol>

            <div class="crew-hours" role="table" aria-label="Hourly forecast for the shift">
              {plan.hours.map((h) => (
                <div role="row">
                  <span role="cell" class="num t">{clock(h.time)}</span>
                  <span role="cell" class={`num scale-${aqiBand(h.metrics.us_aqi_pm25 ?? null)} chipcell`}>
                    {h.metrics.us_aqi_pm25 ?? "–"}
                  </span>
                  <span role="cell" class={`num fg-${heatBand(h.metrics.temp_f)}`}>
                    {h.metrics.temp_f === undefined ? "–" : `${Math.floor(h.metrics.temp_f)}°`}
                  </span>
                  {home && (() => {
                    const hour = Number(h.time.slice(11, 13));
                    const peak = hour >= home.peak_price.start && hour < home.peak_price.end;
                    const cool = home.precool && hour >= home.precool.start && hour < home.precool.end;
                    return (
                      <span role="cell" class={`tou ${peak ? "tou-peak" : cool ? "tou-cool" : ""}`} title={peak ? "Peak price" : cool ? "Pre-cool" : "Off-peak"}>
                        {peak ? "peak" : cool ? "cool" : ""}
                      </span>
                    );
                  })()}
                  {co2 && (
                    <span role="cell" class="num co2" title="Typical grid CO₂ at this hour, g/kWh">
                      {co2At(h.time) ?? "–"}
                    </span>
                  )}
                </div>
              ))}
            </div>
            <p class="crew-legend">
              Top: PM2.5 AQI (NowCast). Middle: air temperature, °F.{home ? ` Bar: electricity price, ${home.peak_price.tariff} peak ${home.peak_price.start}:00–${home.peak_price.end}:00 every day${home.precool ? "; “cool” marks the cheap hours to pre-cool a house before it" : ""}.` : ""}{co2Legend}
            </p>

            <div class="crew-block no-print" id="map">
              <div class="eyebrow">Where the smoke goes</div>
              <CrewMap
                client:only="react"
                lat={answer.place.lat}
                lon={answer.place.lon}
                name={answer.place.name}
                fires={answer.fires_near}
                monitor={plan.confidence.ground && plan.confidence.ground.nearest_lat !== undefined && plan.confidence.ground.nearest_lon !== undefined
                  ? { lat: plan.confidence.ground.nearest_lat, lon: plan.confidence.ground.nearest_lon, name: plan.confidence.ground.nearest, pm25: plan.confidence.ground.pm25 }
                  : null}
                wind={answer.wind}
                shift={answer.shift}
              />
              <p class="crew-legend">
                Red dots: NASA VIIRS fire detections, last 24 h. Green: the AirNow monitor the plan was checked against. Orange: three hours of the shift’s mean wind downwind of each fire, a cone, not a dispersion model; darker when it covers this place.
              </p>
            </div>
            <div class="crew-block" id="record">
              <div class="eyebrow">After a fire: the reading and the record</div>
              {answer.dispatch.reading_advised ? (
                <div class="crew-task crew-task-launch">
                  <svg class="crew-bearing" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" style={`transform:rotate(${answer.dispatch.bearing_deg ?? 0}deg)`}>
                    <path d="M12 2 L18 14 L12 11 L6 14 Z" fill="currentColor" />
                    <path d="M12 11 V22" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  </svg>
                  <div>
                    <b>A worksite reading is advised</b>
                    <span class="crew-task-where">fire at bearing <span class="num">{answer.dispatch.bearing_deg ?? "–"}°</span>, <span class="num">{answer.dispatch.distance_km ?? "–"}</span> km</span>
                    <p>{answer.dispatch.reason}.</p>
                  </div>
                </div>
              ) : (
                <div class="crew-task crew-task-standby">
                  <svg class="crew-bearing" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" style={`transform:rotate(${answer.dispatch.bearing_deg ?? 0}deg)`}>
                    <path d="M12 2 L18 14 L12 11 L6 14 Z" fill="currentColor" />
                    <path d="M12 11 V22" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  </svg>
                  <span>
                    No worksite reading needed{answer.dispatch.distance_km !== null ? <>: nearest fire <span class="num">{answer.dispatch.distance_km}</span> km</> : ": no fire within about 200 km"}
                  </span>
                </div>
              )}
              <p>
                <b>How the AQI was determined (§5141.1(c)):</b> {determination} Worksite instrument (Appendix A: 0.3–2.5 µm, used per the manufacturer, error accounted for): a handheld meter or a fixed node reports its PM2.5 through <code>POST /api/crew/report</code> and the next plan is corrected by it like by any AirNow monitor; the record prints with the plan.
              </p>
              <p class="crew-legend">
                §5141.1 requires N95s at AQI 151+ and respirators above 500; it does not forbid the work. The employer determines the AQI; this page records how.
              </p>
            </div>
            <div class="crew-block">
              <div class="eyebrow">Building ventilation</div>
              <p>
                {plan.bms.recirculate_at
                  ? `Close outside-air dampers at ${clock(plan.bms.recirculate_at)} and recirculate through MERV 13 or better${plan.bms.resume_at ? `; open them again at ${clock(plan.bms.resume_at)}` : " for the rest of the day"}. Outdoor AQI peaks at ${plan.bms.peak_aqi}.`
                  : `Outdoor AQI stays under ${plan.bms.threshold_aqi} (peak ${plan.bms.peak_aqi ?? "–"}). Normal ventilation.`}
              </p>
            </div>
            <div class="crew-block">
              <div class="eyebrow">Home</div>
              {home ? (
                <>
                  <p>
                    {home.precool
                      ? `Cool the house ${home.precool.start}:00–${home.precool.end}:00, before the ${home.peak_price.start}:00–${home.peak_price.end}:00 peak price, then hold. `
                      : `Under 80 °F: no pre-cooling needed; the peak price runs ${home.peak_price.start}:00–${home.peak_price.end}:00. `}
                    {home.close_windows_at
                      ? `Smoke: windows shut and HVAC on recirculate from ${clock(home.close_windows_at)}${home.open_windows_at ? ` to ${clock(home.open_windows_at)}` : " for the rest of the day"}; a closed house runs the air conditioner longer, so the pre-cooling matters more.`
                      : "No smoke hour: windows can stay open overnight."}
                  </p>
                  <div class="eyebrow" style="margin-top:14px">Backup battery · {backup?.hours} h</div>
                  <table class="crew-battery">
                    <thead>
                      <tr><th>Keeps running</th><th class="num">W</th><th class="num">kWh for {backup?.hours} h</th></tr>
                    </thead>
                    <tbody>
                      {battery.map((b) => (
                        <tr><td>{b.name}</td><td class="num">{b.watts}</td><td class="num">{b.kwh.toFixed(1)}</td></tr>
                      ))}
                    </tbody>
                  </table>
                  <p class="crew-legend">{batteryWhy}</p>
                </>
              ) : (
                <p>
                  {plan.bms.recirculate_at
                    ? `Smoke: windows shut and HVAC on recirculate from ${clock(plan.bms.recirculate_at)}${plan.bms.resume_at ? ` to ${clock(plan.bms.resume_at)}` : " for the rest of the day"}.`
                    : "No smoke hour: windows can stay open overnight."}{" "}
                  No electricity tariff is modelled outside the United States.
                </p>
              )}
              <p class="crew-legend no-print">
                Same day as JSON for a building system, a home agent or a sensor node (<code>plan.bms</code>, <code>home</code>, <code>alerts</code>{co2 ? <>, <code>grid_co2</code></> : null}, <code>dispatch</code>{answer.dispatch.reading_advised ? `: reading advised, fire ${answer.dispatch.distance_km} km at ${answer.dispatch.bearing_deg}°` : ""}): <a href={apiUrl}>{apiUrl}</a>
              </p>
            </div>
            <div class="crew-block no-print" id="sky">
              <div class="eyebrow">Check the sky</div>
              <p>Take a photo of the horizon. A vision model (TypeSafe Jev) says whether it sees smoke, and we compare that with the forecast for this hour. Photos of people are not needed: frame the sky.</p>
              <div class="crew-sky">
                <label class="crew-sky-pick">
                  <input type="file" accept="image/*" capture="environment" data-sky-file />
                  <span>Choose or take a photo</span>
                </label>
                <output class="crew-sky-out" data-sky-out aria-live="polite"></output>
              </div>
            </div>

            <div class="crew-block" id="reports">
              <div class="eyebrow">Reports from the crew · {reports.length} today</div>
              {sent && <p class="crew-ok no-print" role="status">Sent to the crew lead. Report #{sent}. If nothing changes in {ESCALATE_AFTER_MIN} minutes, you can take it further below.</p>}
              {handled && <p class="crew-ok no-print" role="status">Report #{handled} marked handled.</p>}
              <form class="crew-report no-print" method="post" action="/api/crew/report">
                <input type="hidden" name="place" value={place} />
                <input type="hidden" name="date" value={date} />
                <input type="hidden" name="shift" value={shiftRaw} />
                <input type="hidden" name="lat" data-geo="lat" />
                <input type="hidden" name="lon" data-geo="lon" />
                <input type="hidden" name="accuracy_m" data-geo="acc" />
                <p>Air got worse, someone feels sick, or something the rules require is missing? Tell the crew lead. No name needed. The report carries the forecast, the satellite fire check and the monitor reading for this hour.</p>
                <div class="crew-kinds">
                  {REPORT_KINDS.map((k, i) => (
                    <label><input type="radio" name="kind" value={k} checked={i === 0} required /> {REPORT_LABELS[k]}</label>
                  ))}
                </div>
                <label class="crew-geo"><input type="checkbox" data-geo-ask /> Add where I am (rounded to about 100 m)</label>
                <details class="crew-sends" open>
                  <summary>What is sent, and to whom</summary>
                  <p><b>To:</b> this page for {answer?.place.name ?? place}, {dayLabel(date)}. The crew lead sees it here, and so does anyone who has this page’s link. Nothing goes to an agency, union or employer’s system unless someone chooses to forward it.</p>
                  <p><b>Sent:</b> the kind you pick, your note, the time, and this hour’s forecast, the nearest satellite fire and the nearest air monitor reading.<span data-geo-line hidden> Also where you are, rounded to about 100 m.</span></p>
                  <p><b>Not sent:</b> your name, phone, email or photo. Your IP is not stored; a one-way code made from it is kept 2 days to stop spam. <a href="/crew/privacy">Privacy</a></p>
                </details>
                <div class="crew-report-row">
                  <input name="note" maxlength="280" placeholder="Optional: where, what you see (no names)" />
                  <button type="submit">Send report</button>
                </div>
              </form>
              {rows.length > 0 && (
                <ol class="crew-actions crew-reports">
                  {rows.map((r) => (
                    <li>
                      <span class="num">{ptClock(r.created_at)}</span>
                      <span>
                        <b>{r.label}</b>{r.note ? ` · ${r.note}` : ""}
                        {r.from && <span class="crew-handled"><br />{r.from}</span>}
                        {r.status === "handled" && r.handled_at && (
                          <span class="crew-handled"> · handled {ptClock(r.handled_at)}{r.handled_note ? `: ${r.handled_note}` : ""}</span>
                        )}
                      </span>
                      <span class="cite">
                        {r.status === "open" ? (
                          <span class="no-print crew-report-acts">
                            <form method="post" action="/api/crew/report">
                              <input type="hidden" name="place" value={place} />
                              <input type="hidden" name="date" value={date} />
                              <input type="hidden" name="shift" value={shiftRaw} />
                              <input type="hidden" name="action" value="handle" />
                              <input type="hidden" name="id" value={r.id} />
                              <button type="submit">Mark handled</button>
                            </form>
                            <a class="crew-complaint" href={`/crew/escalate?report=${r.id}&place=${encodeURIComponent(place)}&date=${date}`}>
                              {r.age >= ESCALATE_AFTER_MIN ? "Not handled: prepare a complaint" : `Prepare a ${agency} complaint`}
                            </a>
                            {r.age < ESCALATE_AFTER_MIN && (
                              <span>usually after {ESCALATE_AFTER_MIN} min ({ESCALATE_AFTER_MIN - r.age} left)</span>
                            )}
                          </span>
                        ) : (
                          "handled"
                        )}
                        <span class="print-only">#{r.id} {r.status}</span>
                      </span>
                    </li>
                  ))}
                </ol>
              )}
            </div>

            <div class="crew-signoff print-only">
              <div class="eyebrow">How the AQI was determined · §5141.1(c)</div>
              <p>{determination} Worksite instrument (Appendix A: 0.3–2.5 µm, used per the manufacturer, error accounted for): model ______________ reading ______ µg/m³ at ______ by ______________. The determination is the employer’s; where a reading and the forecast disagree, the worse applies.</p>
              <div class="eyebrow" style="margin-top:10px">Pre-shift briefing</div>
              <p>Given by ______________________ at ________ · Water, shade and N95 location: ______________________</p>
              <table>
                <thead><tr><th>Name</th><th>Signature</th><th>Name</th><th>Signature</th></tr></thead>
                <tbody>{Array.from({ length: 6 }, () => <tr><td /><td /><td /><td /></tr>)}</tbody>
              </table>
              <p class="crew-legend">Forecast made {madeAt} PT from {pageUrl}. A planning aid, not legal advice.</p>
            </div>
          </>
        )
      }

      <div class="crew-block no-print">
        <h2>What it is worth, in money and time</h2>
        <div class="crew-pays">
          <div>
            <div class="eyebrow">If you run the crew</div>
            <ul>
              <li><b>Fines.</b> Heat illness (§3395) is Cal/OSHA’s most-cited rule in agriculture, every year: 130 violations and $404,000 in 2017–18, about $3,300 each. Willful cases go far higher: $276,425 for one landscaping company in 2024.</li>
              <li><b>The usual miss is paper:</b> no plan on site. The printed sheet with the briefing sign-off is that plan, made in a minute.</li>
              <li><b>Time.</b> No one has to check the air every morning. The plan says the hour each rule starts and the clean window, so heavy work moves instead of the shift stopping.</li>
              <li><b>Reports handled in 30 minutes</b> stay a fix between you and your crew, not a complaint.</li>
            </ul>
          </div>
          <div>
            <div class="eyebrow">If you work outside</div>
            <ul>
              <li><b>N95s are owed to you at AQI 151.</b> The employer provides them; you should not pay. In a 2025 Sonoma study nearly a third of farmworkers bought their own.</li>
              <li><b>Shade and water at 80°F, breaks and a watchful eye at 95°F</b> are the law, not a favour.</li>
              <li><b>One tap, no name.</b> A report reaches the crew lead with the air data attached, so it is not your word against theirs.</li>
              <li><b>Protected.</b> Firing or punishing you for a safety report is illegal (Labor Code §6310).</li>
            </ul>
          </div>
        </div>
        <p class="crew-legend" style="padding:6px 0 0">Sources: AgSafe/WCNGG Cal/OSHA enforcement summaries; DIR news release 2024-105; Sonoma County farmworker study, 2025.</p>
      </div>

      <div class="crew-block no-print">
        <h2>Why our AQI can be higher than your weather app's</h2>
        <p>
          The AQI in a forecast feed is usually a 24-hour average; Open-Meteo’s is. Cal/OSHA goes by
          the current AQI, which the EPA calculates as a NowCast weighted toward the last few hours.
          Smoke that rolls in at noon barely moves a daily average before evening. With the NowCast, an hour at 100 µg/m³
          after eleven clean ones already reads AQI 149, where the daily figure shows about 55.
        </p>
        <p>
          The smoke forecast comes from CAMS, a model with grid cells about 40 km wide, and it runs
          low right next to a fire. So every plan is checked two ways. NASA’s VIIRS satellites flag
          active fires twice a day, and a detection within 50 km gets a warning. The latest hour from
          AirNow’s regulatory monitors within 25 km is compared with the model: if they disagree by
          more than 1.5×, the forecast is scaled toward the monitor around that hour, and the
          correction fades over about 12 hours. If you can see smoke, trust your eyes over this page.
        </p>
      </div>

      <div class="crew-block no-print">
        <h2>The rules, as we read them</h2>
        <ol class="crew-actions">
          <li><span class="num">AQI 151</span><span>N95s available for voluntary use, crew told about the smoke, exposure cut where you can (55.5 µg/m³ PM2.5).</span><span class="cite">T8 §5141.1</span></li>
          <li><span class="num">AQI 500+</span><span>Respirators required; above the scale, so the rule works on concentration: 500.5 µg/m³.</span><span class="cite">T8 §5141.1, App. A</span></li>
          <li><span class="num">80°F</span><span>Shade up, water close by.</span><span class="cite">T8 §3395</span></li>
          <li><span class="num">95°F</span><span>High-heat procedures: pre-shift meeting, someone watching the crew.</span><span class="cite">T8 §3395</span></li>
        </ol>
        <p class="crew-legend">
          This is a planning aid, not legal advice (<a href="/crew/privacy">privacy and terms</a>). The rules live in one data file per state, and
          the code is open: <a href={REPO}>{REPO.replace("https://", "")}</a>. Built at the Stanford
          Cleantech Hackathon, October 2026.
        </p>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  // Place search: suggestions as you type, and "Use my location" plans for where you stand.
  const placeInput = document.querySelector("[data-place]");
  // Same list and keys as the search in the bar; picking a place plans it straight away.
  const list = document.getElementById("crew-places");
  let t, ac, hits = [], cursor = 0;
  const show = (on) => { list.hidden = !on; placeInput.setAttribute("aria-expanded", String(on)); };
  const pick = (h) => { placeInput.value = h.value; show(false); placeInput.form.requestSubmit(); };
  const draw = (q, busy) => {
    list.replaceChildren(...hits.map((h, i) => {
      const a = document.createElement("a");
      a.className = i === cursor ? "hit is-on" : "hit";
      a.setAttribute("role", "option");
      a.href = "#";
      a.innerHTML = '<span class="hit-name"></span><span class="hit-detail"></span>';
      a.children[0].textContent = h.name;
      a.children[1].textContent = h.detail;
      a.addEventListener("mousedown", (e) => { e.preventDefault(); pick(h); });
      return a;
    }));
    if (!hits.length) list.replaceChildren(Object.assign(document.createElement("div"), { className: "hit-empty", textContent: busy ? "Searching…" : `Nothing matches “${q}”. Try the nearest town.` }));
    show(true);
  };
  placeInput?.addEventListener("input", () => {
    clearTimeout(t); ac?.abort();
    const q = placeInput.value.trim();
    if (q.length < 2 || /^-?\d/.test(q)) return show(false);
    hits = []; draw(q, true);
    t = setTimeout(async () => {
      ac = new AbortController();
      try {
        const r = await fetch(`/api/crew/places?q=${encodeURIComponent(q)}`, { signal: ac.signal });
        const { places } = await r.json();
        hits = places.map((p) => ({ name: p.name, detail: p.detail, value: `${p.name}, ${p.detail.split(", ").pop()}` }));
        cursor = 0; draw(q, false);
      } catch {}
    }, 180);
  });
  placeInput?.addEventListener("keydown", (e) => {
    if (e.key === "Escape") return show(false);
    if (list.hidden || !hits.length) return;
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault();
      cursor = (cursor + (e.key === "ArrowDown" ? 1 : hits.length - 1)) % hits.length;
      draw(placeInput.value.trim(), false);
    } else if (e.key === "Enter") { e.preventDefault(); pick(hits[cursor]); }
  });
  placeInput?.addEventListener("blur", () => setTimeout(() => show(false), 150));
  document.querySelector("[data-locate]")?.addEventListener("click", (e) => {
    const b = e.currentTarget;
    if (!navigator.geolocation) return;
    b.textContent = "Locating…";
    navigator.geolocation.getCurrentPosition(
      (p) => {
        placeInput.value = `${p.coords.latitude.toFixed(3)},${p.coords.longitude.toFixed(3)}`;
        placeInput.form.submit();
      },
      () => { b.textContent = "Location unavailable"; },
      { timeout: 10000 },
    );
  });
</script>

<script is:inline>
  // Location only when the worker ticks the box, and only into the form; nothing is sent until Send.
  document.querySelector("[data-geo-ask]")?.addEventListener("change", (e) => {
    if (!e.target.checked || !navigator.geolocation) return;
    navigator.geolocation.getCurrentPosition(
      (p) => {
        document.querySelector("[data-geo-line]")?.removeAttribute("hidden");
        document.querySelector('[data-geo="lat"]').value = p.coords.latitude;
        document.querySelector('[data-geo="lon"]').value = p.coords.longitude;
        document.querySelector('[data-geo="acc"]').value = p.coords.accuracy;
      },
      () => { e.target.checked = false; },
      { enableHighAccuracy: true, timeout: 10000 },
    );
  });
</script>

<script is:inline define:vars={{ skyPlace: place }}>
  // Progressive: without JavaScript the section is just a hint. The photo is shrunk to 768 px in
  // the browser and sent as raw JPEG, the same contract the app uses.
  const input = document.querySelector("[data-sky-file]");
  const out = document.querySelector("[data-sky-out]");
  input?.addEventListener("change", async () => {
    const file = input.files?.[0];
    if (!file || !out) return;
    out.textContent = "Looking at the sky…";
    try {
      const bmp = await createImageBitmap(file);
      const k = Math.min(1, 768 / Math.max(bmp.width, bmp.height));
      const c = document.createElement("canvas");
      c.width = Math.round(bmp.width * k);
      c.height = Math.round(bmp.height * k);
      c.getContext("2d").drawImage(bmp, 0, 0, c.width, c.height);
      const jpeg = await new Promise((r) => c.toBlob(r, "image/jpeg", 0.82));
      const res = await fetch(`/api/sky-check?place=${encodeURIComponent(skyPlace)}`, {
        method: "POST",
        headers: { "content-type": "image/jpeg" },
        body: jpeg,
      });
      const d = await res.json();
      if (d.error) throw new Error(d.error);
      const pct = Math.round((d.smoke ?? 0) * 100);
      let line = `${d.verdict} Smoke ${pct}%.`;
      if (d.model?.aqi != null) line += ` Forecast for this hour: AQI ${d.model.aqi}.`;
      if (d.looks_worse_than_model) line += " Looks worse than the forecast: report it below.";
      out.textContent = line;
      out.dataset.call = d.smoke_call;
      if (d.smoke_call === "yes") {
        const radio = document.querySelector('input[name="kind"][value="smoke"]');
        const note = document.querySelector('.crew-report input[name="note"]');
        if (radio) radio.checked = true;
        if (note && !note.value) note.value = `Sky check: ${d.verdict}`.slice(0, 280);
      }
    } catch (e) {
      out.textContent = `Could not check: ${e.message}`;
    }
  });
</script>


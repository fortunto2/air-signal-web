---
/**
 * Every country, densest first.
 *
 * The hub. Without it the site's ten thousand city pages are reachable only from a sitemap and a
 * WebGL map — which is to say, not reachable at all by anything that follows links. This is three
 * clicks from the home page to any city on Earth, and it costs one query because the totals are
 * already rolled up in the countries table.
 */
import Layout from "../layouts/Layout.astro";
import Bar from "../components/Bar.astro";
import SortBar from "../components/SortBar.astro";
import { COUNTRY_SORTS, countrySort, listCountries, getLastIngest, getSitemapCounts } from "../lib/db";
import { SITE, abs, comfortBand, paths, pmBand } from "../lib/site";

const sort = countrySort(Astro.url.searchParams.get("sort"));

const [countries, counts, lastIngest] = await Promise.all([
  listCountries(sort),
  // Not a sum of the rollup columns: those are maintained by the ETL and would disagree with the
  // rest of the site the first moment a rollup half-failed — in an indexed <title>, silently.
  getSitemapCounts(),
  getLastIngest(),
]);

const withSensors = countries.filter((c) => c.station_count > 0);
const totalCities = counts.cities;
const totalStations = counts.stations;

const description =
  `Air quality and outdoor comfort in ${countries.length} countries — ${totalCities} cities and ` +
  `${totalStations} community sensors, scored on fourteen environmental signals.`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Air quality by country",
    description,
    url: abs(paths.countries()),
    isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.origin },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: countries.length,
      itemListElement: countries.slice(0, 50).map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        url: abs(paths.country(c.slug)),
      })),
    },
  },
];
---

<Layout
  title={`Air Quality by Country — ${countries.length} Countries Compared`}
  description={description}
  path={paths.countries()}
  schema={schema}
  updatedAt={lastIngest}
>
  <main class="wrap" style="padding-top:22px" id="main">
    <div class="app">
      <Bar>
        <div class="eyebrow">
          {countries.length} countries · {totalCities.toLocaleString("en-US")} cities ·{" "}
          {totalStations.toLocaleString("en-US")} sensors
        </div>
      </Bar>

      <div style="padding:24px 20px 10px">
        <h1 style="font-size:27px;margin:0">Every country</h1>
        <p style="margin-top:9px;max-width:64ch;font-size:14.5px">
          All {countries.length} of them, {withSensors.length} with a community sensor. The rest
          still carry real numbers for every city — Open-Meteo covers every coordinate on Earth —
          they are modelled rather than measured, and the row says which.
        </p>
      </div>

      <SortBar
        options={Object.fromEntries(Object.entries(COUNTRY_SORTS).map(([k, v]) => [k, v.label]))}
        active={sort}
        base="/countries"
      />

      <div class="rows">
        <div style="display:flex;justify-content:space-between;padding:12px 20px 8px">
          <div class="eyebrow">Country</div>
          <div class="eyebrow">Comfort</div>
        </div>

        {/*
          Every country is a row now. The eighty-nine without a community sensor used to be a cloud
          of chips under the sixty-seven that had one, which read as a footnote to the real list —
          and that is not what they are. Open-Meteo covers every coordinate on Earth, so a country
          with no device still has fourteen real signals per city; what it lacks is a *measurement*
          to check the model against, and saying so in the row is more honest than demoting it.
        */}
        {
          countries.map((c, i) => (
            <a class="row" href={paths.country(c.slug)}>
              <span class="rank num">{i + 1}</span>
              <span>
                <span class="city">{c.name}</span>{" "}
                <span class="country">
                  {c.station_count > 0
                    ? `${c.station_count} sensor${c.station_count === 1 ? "" : "s"}`
                    : "modelled"}
                  {" · "}
                  {c.city_count} cities
                  {c.pm25_median !== null && (
                    <span class={`fg-${pmBand(c.pm25_median)}`}>
                      {" "}
                      · {c.pm25_median.toFixed(1)} µg/m³
                    </span>
                  )}
                </span>
              </span>
              <span />
              <span class:list={["n", c.comfort !== null && `fg-${comfortBand(c.comfort)}`]}>
                {c.comfort ?? "—"}
              </span>
            </a>
          ))
        }
      </div>

    </div>
  </main>
</Layout>

---
/**
 * The home page.
 *
 * Its job is to make the argument in one screen: this is not an AQI number, it is a reading across
 * everything that makes being outside pleasant or not. So the spectrum comes first, at hero size,
 * with a real city's real numbers under it — and the ranking below proves the glyph survives being
 * shrunk into a list row, which is the whole reason that shape was chosen over a ring.
 */
import Layout from "../layouts/Layout.astro";
import Bar from "../components/Bar.astro";
import Spectrum from "../components/Spectrum.astro";
import LiveCity from "../components/LiveCity.tsx";
import MyPlace from "../components/MyPlace.tsx";
import { getComfortExtremes, getLastIngest, getSitemapCounts } from "../lib/db";
import { cityView, ago } from "../lib/view";
import { SITE, paths } from "../lib/site";

const [{ best, worst }, counts, lastIngest] = await Promise.all([
  getComfortExtremes(6),
  getSitemapCounts(),
  getLastIngest(),
]);

// The hero speaks for one real place. The most comfortable city with sensors is the honest pick:
// it is the best thing the network measured today, not a city chosen for its name.
const heroView = best[0] ? cityView(best[0]) : null;

const description =
  "Live air quality and outdoor comfort for any city: PM2.5 from community sensors combined with " +
  "temperature, wind, sea, UV, pollen and ten more signals into one score.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: SITE.name,
    url: SITE.origin,
    applicationCategory: "ReferenceApplication",
    operatingSystem: "Any",
    description,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
];

const stamp = ago(lastIngest);
---

<Layout
  title={`${SITE.name} — ${SITE.tagline}`}
  description={description}
  path="/"
  schema={schema}
  updatedAt={lastIngest}
>
  <main class="wrap" style="padding-top:22px" id="main">
    <div class="app">
      <Bar search={`Search ${counts.cities.toLocaleString("en-US")} cities`} />

      {
        heroView ? (
          <div class="readout">
            <div>
              <div class="eyebrow">
                Now · {heroView.name}, {heroView.country}
              </div>
              <div class="score" style="margin-top:10px">
                <div class:list={["value", heroView.band && `fg-${heroView.band}`]} data-live="comfort">
                  {heroView.comfort}
                </div>
                <div class="of">/100</div>
              </div>
              <div class="verdict">
                <div class:list={["word", heroView.band && `fg-${heroView.band}`]}>
                  {heroView.word} outside
                </div>
                <div class="where">
                  {heroView.worst?.measure
                    ? `${heroView.worst.name} is the one thing holding it back`
                    : `${heroView.stationCount} sensors within reach`}
                </div>
              </div>
              <p style="margin-top:14px">
                <a href={heroView.path} class="seg" style="text-decoration:none">
                  Open {heroView.name} →
                </a>
              </p>
            </div>

            <div>
              <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:9px">
                <div class="eyebrow">Fourteen signals</div>
                <div class="eyebrow">
                  Updated {stamp} · {heroView.stationCount} sensors
                </div>
              </div>
              <Spectrum scores={heroView.scores} size="hero" />
              <div style="height:20px" />
            </div>
          </div>
        ) : (
          <div style="padding:34px 20px">
            <h1>
              {SITE.brand.head}
              <span style="color:var(--accent)">{SITE.brand.tail}</span>
            </h1>
            <p class="lede" style="margin-top:14px">{description}</p>
            {/*
              The comfort pass has not run yet — the model upstream has a daily ceiling and the
              scores arrive with the next scheduled ingest. The sensors are already here, so say
              what is true and point at the thing that works, rather than showing a visitor an
              apology or, worse, a shell command.
            */}
            <p style="margin-top:18px;display:flex;gap:10px;flex-wrap:wrap">
              <a class="seg" style="text-decoration:none" href={paths.map()}>Open the map →</a>
              <a class="seg" style="text-decoration:none" href="/how-it-works">How it works →</a>
            </p>
            <p class="eyebrow num" style="margin-top:16px">
              {counts.stations.toLocaleString("en-US")} community sensors across{" "}
              {counts.cities.toLocaleString("en-US")} cities · comfort scores land with the next
              refresh
            </p>
          </div>
        )
      }

      {/*
        Personalisation lives in an island because the HTML is cached at the edge for everyone. A
        page rendered per visitor is a page nobody gets quickly, and "is it worth going outside" is
        a question about *here* — so the answer arrives after the cache, not instead of it.
      */}
      <MyPlace client:idle />

      {
        ([["Most comfortable right now", best], ["Worst right now", worst]] as const).map(
          ([heading, rows]) =>
            rows.length > 0 && (
              <div class="rows is-compact">
                <div style="display:flex;justify-content:space-between;padding:12px 20px 8px">
                  <div class="eyebrow">{heading}</div>
                  <div class="eyebrow">Comfort</div>
                </div>
                {rows.map((c, i) => {
                  const v = cityView(c);
                  return (
                    <a class="row" href={v.path}>
                      <span class="rank num">{i + 1}</span>
                      <span>
                        <span class="city">{v.name}</span> <span class="country">{v.country}</span>
                      </span>
                      <Spectrum scores={v.scores} size="mini" />
                      <span class:list={["n", v.band && `fg-${v.band}`]}>{v.comfort}</span>
                    </a>
                  );
                })}
              </div>
            ),
        )
      }

      <div style="padding:16px 20px 20px;display:flex;gap:22px;flex-wrap:wrap;align-items:baseline">
        <a class="seg" style="text-decoration:none" href={paths.map()}>
          Open the map →
        </a>
        <span class="eyebrow num">
          {counts.cities.toLocaleString("en-US")} cities · {counts.stations.toLocaleString("en-US")}{" "}
          community sensors · {counts.stationsIndexable.toLocaleString("en-US")} past the quality bar
        </span>
      </div>
    </div>

    <section style="padding:44px 0 8px">
      <h2 style="font-size:clamp(24px,4vw,34px);font-weight:640">Colour belongs to the data.</h2>
      <p class="lede" style="margin-top:12px">
        Every other air-quality site paints its chrome in the same traffic-light green. If the
        interface is already coloured, a reading has nothing left to say — so this one is
        near-neutral, and the only saturated pixels on the page <em>are</em> the measurements.
      </p>

      <div class="cols" style="margin-top:22px">
        <div class="card">
          <div class="eyebrow">Community sensors lie, and nobody says so</div>
          <p style="font-size:13.5px">
            A cheap device indoors, next to a road, or with a dying fan reads several times high.
            Every map plots that at face value. Here the sensors are compared against the
            atmospheric model, the ones that disagree are down-weighted, and each station page says
            by how much.
          </p>
        </div>
        <div class="card">
          <div class="eyebrow">A person does not go outside for PM2.5</div>
          <p style="font-size:13.5px">
            They go out into a combination of heat, wind, UV, pollen, sea temperature and daylight.
            One AQI number cannot say "the air is clean but the UV will burn you in twenty minutes",
            which is the actually useful sentence.
          </p>
        </div>
      </div>
    </section>

    {heroView && <LiveCity client:idle lat={heroView.lat} lon={heroView.lon} computedAt={heroView.updatedAt?.toISOString() ?? null} />}
  </main>
</Layout>

---
/**
 * The top bar. Logo, an optional breadcrumb, search, navigation.
 *
 * Search is on by default now, on every page rather than only the home page. Ten thousand city
 * pages and nine thousand device pages are not reachable by browsing — the nav offers four
 * destinations and the map offers the rest by eye. A reader who knows the name of the place they
 * want had, before this, no way to type it in except from the front door.
 */
import { SITE, paths } from "../lib/site";
import Search from "./Search.tsx";

interface Props {
  /** Placeholder text for the search box. */
  search?: string;
  /** Opt out entirely — for pages that are themselves a search surface. */
  noSearch?: boolean;
}

const { search = "Search a city or sensor", noSearch = false } = Astro.props;
---

<div class="bar">
  <a class="logo" href="/">
    <span>{SITE.brand.head}</span><span>{SITE.brand.tail}</span>
  </a>

  <slot />

  {
    !noSearch && (
      <>
        {/*
          `client:idle`, not `client:visible`: the bar is above the fold on every page, so a
          visibility check would hydrate it immediately anyway and cost an observer to decide that.
          The fallback below is what a crawler and a reader without JavaScript get — the map, which
          is the browsable route to the same places.
        */}
        <Search client:idle placeholder={search} />
        <noscript>
          <a class="search" href={paths.map()}>
            {search}
          </a>
        </noscript>
      </>
    )
  }

  <nav>
    <a href={paths.map()}>Map</a>
    <a href={paths.countries()}>Countries</a>
    <a href={paths.ranking()}>Ranking</a>
    <a href={paths.guide()}>Guide</a>
    <a href={paths.howItWorks()}>How it works</a>
  </nav>
</div>

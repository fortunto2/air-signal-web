---
/** The top bar. Logo, an optional middle (breadcrumb or search), then navigation. */
import { SITE, paths } from "../lib/site";

interface Props {
  /** Breadcrumb text or markup goes in the default slot. */
  search?: string;
}

const { search } = Astro.props;
---

<div class="bar">
  <a class="logo" href="/">
    <span>{SITE.brand.head}</span><span>{SITE.brand.tail}</span>
  </a>

  {
    search && (
      <a class="search" href={paths.map()} role="search" aria-label="Search cities">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5" />
          <path d="M11 11l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        {search}
      </a>
    )
  }

  <slot />

  <nav>
    <a href={paths.map()}>Map</a>
    <a href={paths.countries()}>Countries</a>
    <a href={paths.ranking()}>Ranking</a>
    <a href={paths.howItWorks()}>How it works</a>
  </nav>
</div>

---
/**
 * "Put this on your site."
 *
 * The only piece of the site that asks the reader for something, and it asks for the one thing the
 * site actually needs. Nothing links here. The rewrite exists because a crawler saw an empty shell,
 * and it now sees a full page — but a page nobody links to is a page Google has no reason to fetch
 * twice. A widget somebody wants on their own site is a link they place because it is useful to
 * them, which is the only kind worth having.
 *
 * Open, not collapsed. It began as a closed `<details>` on the reasoning that a page whose argument
 * is restraint should not shout — but a request nobody sees is not restraint, it is a request that
 * does not exist. The live widget, the snippet that produced it and the button that copies it now
 * sit on the page, and a reader decides without having to click something to find out what is on
 * offer. The `<details>` element stays because it still lets them fold it away.
 */
import { abs, paths } from "../lib/site";

interface Props {
  /** `turkey/gazipasa` — what the widget will ask for. */
  place: string;
  name: string;
  path: string;
}

const { place, name, path } = Astro.props;

const snippet = `<a href="${abs(path)}" data-airsignal="${place}">Air quality in ${name}</a>
<script async src="${abs("/embed.js")}"><\/script>`;
---

<details class="embed" open>
  <summary>
    <span class="eyebrow">Put this reading on your site</span>
    <span class="embed-hint">free, no key, one line</span>
  </summary>

  <div class="embed-body">
    <p class="embed-lede">
      A live bar with {name}'s air quality, updated whenever someone loads your page. It is an
      ordinary link that upgrades itself, so it still reads correctly if the script never runs.
    </p>

    <!--
      Rendered by the very script it is advertising. A preview drawn by hand would be a promise;
      this is the thing itself, and if the widget breaks the demo breaks with it — which is the
      only way anyone would find out.
    -->
    <div class="embed-demo" style="display:flex;gap:14px;flex-wrap:wrap;align-items:center">
      <a href={path} data-airsignal={place}>Air quality in {name}</a>
      {/* The compact one beside it, so the choice is visible rather than described. */}
      <a href={path} data-airsignal={place} data-airsignal-variant="badge">AQI in {name}</a>
    </div>

    <pre class="embed-code"><code>{snippet}</code></pre>

    <div class="embed-actions">
      <button class="seg" type="button" data-copy>Copy</button>
      <a class="seg" href={paths.embed()} style="text-decoration:none"> Options &amp; API </a>
    </div>
  </div>
</details>

{/* The Copy button is wired in scripts/copy.ts (loaded by the layout). */}

<script is:inline async src="/embed.js"></script>
